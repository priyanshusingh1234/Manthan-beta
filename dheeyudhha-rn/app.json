{
  "expo": {
    "name": "dheeyudha",
    "slug": "dheeyudhha-rn",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/manthan-logo.png",
    "scheme": "dheeyudhharn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.dheeyudha.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.dheeyudha.app",
      "versionCode": 121,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "manthan-beta-c975.vercel.app",
              "pathPrefix": "/"
            },
            {
              "scheme": "dheeyudhharn"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/manthan-logo.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/manthan-logo.png",
          "color": "#4f46e5",
          "androidMode": "default",
          "androidCollapsedTitle": "Manthan",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Manthan to access your photos to upload profile pictures and clips.",
          "cameraPermission": "Allow Manthan to access your camera to take photos of your written answers."
        }
      ],
      "expo-video",
      "expo-font",
      "expo-audio",
      "expo-asset",
      "expo-image",
      "@react-native-google-signin/google-signin",
      "expo-build-properties",
      [
        "@sentry/react-native/expo",
        {
          "organization": "dheeyudha",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "501fde34-5b88-4997-8960-ac5e2065b9e8"
      }
    },
    "owner": "kpk22128",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/501fde34-5b88-4997-8960-ac5e2065b9e8"
    }
  }
}
